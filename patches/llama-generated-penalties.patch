diff --git a/common/sampling.cpp b/common/sampling.cpp
index 564fa9c..c572052 100644
--- a/common/sampling.cpp
+++ b/common/sampling.cpp
@@ -502,7 +502,16 @@ void common_sampler_accept(struct common_sampler * gsmpl, llama_token token, boo
         llama_sampler_accept(gsmpl->grmr, token);
     }
 
-    llama_sampler_accept(gsmpl->chain, token);
+    if (!is_generated && gsmpl->params.penalties_generated_only) {
+        for (int i = 0; i < llama_sampler_chain_n(gsmpl->chain); ++i) {
+            auto * sampler = llama_sampler_chain_get(gsmpl->chain, i);
+            if (strcmp(llama_sampler_name(sampler), "penalties") != 0) {
+                llama_sampler_accept(sampler, token);
+            }
+        }
+    } else {
+        llama_sampler_accept(gsmpl->chain, token);
+    }
 
     gsmpl->prev.push_back(token);
 }
